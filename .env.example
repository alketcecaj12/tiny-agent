# Copy this file to `.env` and adjust. Every setting is optional.
# Any OpenAI-compatible endpoint works; the defaults match the notebooks (Ollama).

# --- Main LLM endpoint ---
TINYAGENT_BASE_URL=http://localhost:11434/v1
TINYAGENT_API_KEY=no_key

# Model with native thinking + tool calling (chapters 5 native, 6 native, 7-10, CLI)
TINYAGENT_MODEL=gemma4:e4b
# Model for the prompt-based chapters (3, 4, 5, 6)
TINYAGENT_PROMPT_MODEL=gemma3:12b
# Vision model (chapter 9)
TINYAGENT_VISION_MODEL=gemma4:e4b-it-qat

# --- Embeddings (chapter 4, long-term memory) ---
TINYAGENT_EMBEDDING_MODEL=embeddinggemma
# TINYAGENT_EMBEDDING_BASE_URL=   # defaults to TINYAGENT_BASE_URL
# TINYAGENT_EMBEDDING_API_KEY=    # defaults to TINYAGENT_API_KEY

# --- LLM-as-a-judge (chapter 7); defaults to the main LLM ---
# TINYAGENT_JUDGE_MODEL=gemini-3.1-flash-lite
# TINYAGENT_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# TINYAGENT_JUDGE_API_KEY=

# --- Behaviour ---
# Native reasoning in the `tinyagent` CLI
TINYAGENT_THINK=true
# Set to false if your provider rejects the `reasoning_effort` parameter
TINYAGENT_SEND_REASONING_EFFORT=true

# --- Other providers (uncomment one block) ---
# llama.cpp:  TINYAGENT_BASE_URL=http://127.0.0.1:8080/v1   TINYAGENT_MODEL=gemma-4-e4B-it-Q4_K_M
# LM Studio:  TINYAGENT_BASE_URL=http://127.0.0.1:1234/v1   TINYAGENT_MODEL=gemma-4-e4b-it
# OpenRouter: TINYAGENT_BASE_URL=https://openrouter.ai/api/v1
#             TINYAGENT_API_KEY=sk-or-...
#             TINYAGENT_MODEL=google/gemma-4-31b-it
#             TINYAGENT_PROMPT_MODEL=google/gemma-3-12b-it
